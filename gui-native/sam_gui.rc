// sam_gui.rc - resources for the SAM GUI.
//
// The CMU dictionary is linked in here rather than compiled as a C array:
// 126k entries is 3.6 MB of data that never needs a compiler. Run
// native/tools/gen_dict.py before building, or the executable comes out
// without a pronunciation dictionary and says so on startup.

#include <windows.h>
#include "resource.h"

IDR_CMUDICT RCDATA "..\\native\\data\\sam.dict"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "sam_gui.manifest"

// Keep in step with version in nvda-addon/manifest.ini. The release
// script checks that these agree and stops if they do not.
VS_VERSION_INFO VERSIONINFO
  FILEVERSION     1,5,0,0
  PRODUCTVERSION  1,5,0,0
  FILEFLAGSMASK   0x3fL
  FILEFLAGS       0x0L
  FILEOS          VOS_NT_WINDOWS32
  FILETYPE        VFT_APP
  FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "SAM - Software Automatic Mouth"
            VALUE "FileVersion",     "1.5.0.0"
            VALUE "InternalName",    "sam_gui"
            VALUE "OriginalFilename","sam_gui.exe"
            VALUE "ProductName",     "SAM"
            VALUE "ProductVersion",  "1.5.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
