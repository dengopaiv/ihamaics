/node_modules/
/gh-pages
/*.tgz

# Python
__pycache__/
.pytest_cache/
*.pyc
*.pyo

# Build artifacts. The PyInstaller build of sam_gui.py and the built
# addon are not shipped: the addon goes inside sam-native.zip, and
# the Python app stays source-only.
build/sam_gui/
dist/SAM.exe
*.nvda-addon

# Native engine build outputs (golden vectors ARE tracked)
native/build/
gui-native/build/

# The dictionary blob is generated from cmudict.txt, which is tracked.
# Regenerate with: python native/tools/gen_dict.py
native/data/
*.dll
*.obj
*.o
*.lib
*.exp
*.pdb

# Archives. sam-native.zip is the release - the addon and the desktop
# app, both native - and it is the one archive that is tracked here.
*.zip
!/sam-native.zip

# Test outputs
*.wav

# IDE/Tools
.claude/
.vscode/
.idea/
